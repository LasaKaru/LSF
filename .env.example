# ---------------------------------------------------------------------------
# Yathra — example environment file.
#
#   cp .env.example .env
#
# PLACEHOLDERS ONLY. This file is committed; .env is git-ignored.
# The values below are safe local development defaults. They are NOT secrets
# and must never be used in a deployed environment — production reads the same
# variable names from the platform secret store (Kubernetes Secrets / WSO2
# Choreo secure config), so no code changes between environments.
#
# Full reference with scopes and defaults: docs/17-configuration.md
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=yathra
# No default anywhere in the code: a service refuses to start if this is unset.
# For a real deployment generate one with:  openssl rand -base64 32
POSTGRES_PASSWORD=change-me-local-dev-only
CATALOG_DB_NAME=catalog_db
BOOKING_DB_NAME=booking_db
PRICING_DB_NAME=pricing_db
DB_POOL_MAX_SIZE=20
DB_POOL_CONNECTION_TIMEOUT_MS=3000

# --- Booking behaviour ----------------------------------------------------
BOOKING_HOLD_TTL_SECONDS=600
HOLD_SWEEP_INTERVAL_SECONDS=15
HOLD_SWEEP_BATCH_SIZE=500
BOOKING_CUTOFF_MINUTES=30
BOOKING_HORIZON_DAYS=30
MAX_SEATS_PER_BOOKING=6
MAX_ACTIVE_HOLDS_PER_CONTACT=6
BOOKING_RETRY_MAX_ATTEMPTS=3
BOOKING_RETRY_BACKOFF_MS=50
SEGMENT_TURNAROUND_BUFFER_STOPS=0

# --- Pricing --------------------------------------------------------------
# HMAC-SHA256 signing key for fare quotes. Minimum 32 bytes; startup fails if
# shorter. Generate with:  openssl rand -base64 48
QUOTE_SIGNING_KEY=local-development-quote-signing-key-not-a-secret-32b+
QUOTE_TTL_SECONDS=600
CURRENCY=LKR
FARE_ROUNDING_MINOR=1000
FARE_MINIMUM_MINOR=2000
DEMAND_PRICING_ENABLED=false
DEMAND_MULTIPLIER_MIN=0.90
DEMAND_MULTIPLIER_MAX=1.40

# --- Security -------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_BOOKING_PER_MINUTE=10
RATE_LIMIT_READ_PER_MINUTE=120

# --- Feature flags --------------------------------------------------------
FEATURE_SEAT_MAP_ENABLED=true
FEATURE_ADMIN_CONSOLE_ENABLED=true
FEATURE_SCENIC_SURCHARGE_ENABLED=true

# --- Observability --------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=console
